# Ignore the .env file
fastlane/.env

# Ignore any log files generated by Fastlane
fastlane/report.xml
fastlane/screenshots

# Ignore any temporary or build files
fastlane/output
fastlane/tmp
fastlane/Appfile

# Ignore any custom temporary files
fastlane/*.lock

# Ignore system-specific files
.DS_Store

# Ignore Xcode build artifacts
build/
DerivedData/

# Ignore CocoaPods dependencies
/Pods/
